// ============================================
// GENERATOR & DATASOURCE
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupType {
  FAMILY
  FRIENDS
  ROOMMATES
  NEIGHBORS

  TEAM
  DEPARTMENT
  PROJECT

  CLASS
  CLUB
  ASSOCIATION

  SPORTS
  COMMUNITY
  EVENT

  WORK
  OTHER
}

enum GroupMemberStatus {
  INVITED
  ACCEPTED
  REJECTED
  REMOVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepetitionType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ============================================
// USER MODEL
// ============================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  fullName     String
  avatarUrl    String?
  refreshToken String?

  phone    String?
  bio      String?
  jobTitle String?
  company  String?

  timezone String?
  language String?

  workspaces WorkspaceMember[]
  groups     GroupMember[]
  tasks      Task[]            @relation("UserTasksCreated")
  assigned   Task[]            @relation("UserTasksAssigned")

  events CalendarEvent[] @relation("UserEvents")
  logs   ActivityLog[]   @relation("ActivityUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Workspace Workspace[]
  Group     Group[]
}

// ============================================
// WORKSPACE
// ============================================

model Workspace {
  id      String @id @default(uuid())
  name    String
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  groups  Group[]
  members WorkspaceMember[]
  logs    ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([userId, workspaceId])
}

// ============================================
// GROUP MODEL
// ============================================

model Group {
  id          String    @id @default(uuid())
  name        String
  type        GroupType @default(FAMILY)
  description String?
  iconUrl     String?
  tags        String[]
  settings    Json?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  members GroupMember[]
  tasks   Task[]
  events  CalendarEvent[]
  logs    ActivityLog[]

  inviteCode String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model GroupMember {
  id        String            @id @default(uuid())
  userId    String
  groupId   String
  role      GroupRole         @default(MEMBER)
  invitedBy String?
  status    GroupMemberStatus @default(ACCEPTED)
  joinedAt  DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

// ============================================
// TASKS (Phase E Ready)
// ============================================

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  // -----------------------------
  // Parent / Subtask relationship
  // -----------------------------
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("TaskSubtasks")

  // -----------------------------
  // Group / workspace relationships
  // -----------------------------
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  createdById String
  createdBy   User   @relation("UserTasksCreated", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("UserTasksAssigned", fields: [assignedToId], references: [id])

  logs ActivityLog[]
}

// ============================================
// CALENDAR EVENTS
// ============================================

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  startTime   DateTime?
  endTime     DateTime?

  repetition RepetitionType @default(NONE)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  createdById String
  createdBy   User   @relation("UserEvents", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// ============================================
// ACTIVITY LOG (Phase E.8)
// ============================================

model ActivityLog {
  id String @id @default(uuid())

  // Relations
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  userId String
  user   User   @relation("ActivityUser", fields: [userId], references: [id])

  // Data
  action   String
  metadata Json?

  createdAt DateTime @default(now())
}
